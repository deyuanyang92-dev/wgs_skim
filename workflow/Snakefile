# wgs_skim: genome-skimming workflow for animal mitogenomes, nuclear rDNA and genome surveys.
#   snakemake --cores 32 --sdm conda --config reads_dir=/path/to/rawdata
# See README.md and config/README.md.
from pathlib import Path

from snakemake.utils import min_version

min_version("8.0")


# defaults ship with the workflow; --configfile / --config override them
configfile: str(Path(workflow.basedir).parent / "config" / "config.yaml")


include: "rules/common.smk"
include: "rules/qc.smk"
include: "rules/mito.smk"
include: "rules/assembly.smk"
include: "rules/genome_size.smk"
include: "rules/annotate.smk"
include: "rules/nuclear.smk"
include: "rules/transcriptome.smk"
include: "rules/mitofinder.smk"
include: "rules/topology.smk"
include: "rules/blast.smk"
include: "rules/report.smk"


rule all:
    input:
        final_outputs(),


onstart:
    # pipeline_info/: what this run was (the results stay in the tool directories)
    import datetime, sys, yaml
    import snakemake as _smk
    info = Path(OUT_PATH, "pipeline_info")
    info.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    (info / f"config_{stamp}.yaml").write_text(yaml.safe_dump(dict(config), sort_keys=True, allow_unicode=True))
    try:
        from importlib.metadata import version
        wgs_skim_version = version("wgs_skim")
    except Exception:
        wgs_skim_version = "unknown"
    (info / f"run_{stamp}.txt").write_text(
        f"command: {' '.join(sys.argv)}\nwgs_skim: {wgs_skim_version}\nsnakemake: {_smk.__version__}\n"
        f"samples ({len(SAMPLES)}): {' '.join(SAMPLES)}\nsteps: {config.get('steps') or 'all'}\n")
