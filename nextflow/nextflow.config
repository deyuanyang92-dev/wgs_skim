// wgs_skim with Nextflow. Defaults are the keys of config/config.yaml (one source for both workflows); override any
// of them with --key value or -params-file my.yaml (e.g. `wgs_skim config > my.yaml`, or ~/.wgs_skim/config.yaml).
//   nextflow run nextflow/main.nf -profile conda --reads_dir rawdata --outdir results --max_cpus 32 --max_memory '120 GB' -resume

new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/../config/config.yaml")).each { k, v -> params[k] = v }

// Nextflow-only options
params.python = 'python3'                 // runs workflow/scripts/samples.py at start-up (sample detection)
params.conda_prefix = ''                  // where `wgs_skim install` (Snakemake) put the environments: reused if found
params.publish_mode = 'link'              // hard links from work/ (no copy); 'copy' if work/ is on another disk
params.max_cpus = Runtime.runtime.availableProcessors()
params.max_memory = "${(int) (new File('/proc/meminfo').exists() ? new File('/proc/meminfo').readLines().find { it.startsWith('MemTotal:') }.tokenize()[1].toLong() / 1e6 * 0.9 : 8)} GB"
params.slurm_queue = ''
params.slurm_options = ''                 // e.g. '--account=xyz --qos=normal'

manifest {
    name = 'wgs_skim'
    description = 'Genome skimming for animal mitogenomes, nuclear rDNA, histones and genome surveys'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'          // resourceLimits
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']        // as Snakemake's shell: commands
    cpus = 1
    // a failed task is tried once more (memory x attempt where it is estimated); then running tasks finish
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'finish' }
    maxRetries = 1
    // Snakemake scales threads down to --cores; here requests above --max_cpus / --max_memory are capped
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory]
    // per-process threads, as Snakemake --set-threads: withName: SPADES { cpus = 48 }
}

executor {
    $local {
        cpus = params.max_cpus as int        // scheduling by cores and memory (Snakemake --cores / --resources mem_mb)
        memory = params.max_memory
    }
}

conda {
    cacheDir = System.getenv('WGS_SKIM_CONDA_PREFIX') ?: (params.conda_prefix ?: null)
    createTimeout = '2 h'
}

def stamp = new java.util.Date().format('yyyyMMdd_HHmmss')
trace {
    enabled = true                           // per-task cpu / memory / time (Snakemake benchmarks/)
    file = "${params.outdir}/pipeline_info/trace_${stamp}.tsv"
    fields = 'task_id,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,attempt,workdir'
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${stamp}.html"
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${stamp}.html"
}

profiles {
    conda {
        conda.enabled = true
    }
    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_queue ?: null
        process.clusterOptions = params.slurm_options ?: null
        executor {
            queueSize = 50
            submitRateLimit = '10/1min'
        }
    }
    test {
        // the 2-sample regression data of docs/TESTING.md: one reseeded mitogenome round, 200 k pairs for topology
        params.mt_iter_rounds = 1
        params.topology_pairs = 200000
    }
}
